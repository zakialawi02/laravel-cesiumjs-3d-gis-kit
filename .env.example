APP_NAME="3D WebGIS Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE="Asia/Jakarta"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + PostGIS (required: vector layers are stored as PostGIS geometry)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cesium_core
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=7500

CACHE_STORE=database

MAIL_SMTP_ON=false
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Geodata upload & conversion (Docker: GDAL + Cesium Terrain Builder)
GEODATA_MAX_UPLOAD_MB=1000
GEODATA_UPLOAD_SESSION_HOURS=24
GEODATA_UPLOAD_MAX_SESSIONS=4
GEODATA_UPLOAD_MAX_INFLIGHT_MB=2000
GEODATA_MIN_FREE_DISK_MB=512
GEODATA_ZIP_MAX_UNCOMPRESSED_MB=2000
GEODATA_DOCKER_COMPOSE_FILE=docker-compose.tools.yml
GEODATA_DOCKER_COMPOSE_BIN="docker compose"
# Match the PHP worker UID:GID and storage directory ownership on Linux.
GEODATA_CONVERTER_USER=1000:1000
GEODATA_ENABLE_PYTHON_COLOR_PARSER=false

# Coordinate system used for UTM display
GIS_UTM_ZONE=49
GIS_UTM_HEMISPHERE=N
